# Recall 环境变量模板：复制为 .env 后按需修改
# 后端读取前缀 RECALL_*（app/core/config.py）

# 数据目录（SQLite / 图片 / 备份 / 令牌）
RECALL_DATA_DIR=./data

# 监听地址（隐私默认 127.0.0.1；局域网访问需显式改为 0.0.0.0 并在设置页开启）
RECALL_HOST=127.0.0.1
RECALL_PORT=8000

# DeepSeek（OpenAI 兼容协议）
RECALL_DEEPSEEK_BASE_URL=https://api.deepseek.com
RECALL_DEEPSEEK_API_KEY=
RECALL_DEEPSEEK_MODEL=deepseek-chat

# 降级开关：无 Key / 无 Paddle 环境下保持主流程可演示（风险 R1/R2 缓解）
RECALL_AI_MOCK=true
RECALL_OCR_MOCK=true

# 前端开发服务器跨域来源
RECALL_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
